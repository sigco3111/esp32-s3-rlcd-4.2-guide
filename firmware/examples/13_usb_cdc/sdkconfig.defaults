CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_TX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_EP_BUFSIZE=1024
CONFIG_TINYUSB_NET_MODE_NONE=y
CONFIG_TINYUSB_MSC_ENABLED=n
CONFIG_TINYUSB_HID_ENABLED=n
CONFIG_TINYUSB_MIDI_ENABLED=n
CONFIG_TINYUSB_MODE_DMA=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_FREERTOS_HZ=1000

# OTA 슬롯 (자기 업데이트용)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# ★ 16MB 플래시 (이 보드는 16MB다)
#   원본 예제의 sdkconfig 에는 2MB 로 남아 있어 partitions.csv(3.1MB) 와
#   충돌해 "does not fit in configured flash size 2MB" 로 빌드가 막혔다.
#   sdkconfig 는 생성물이라 커밋하지 않으므로 defaults 에 명시해야 한다.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
